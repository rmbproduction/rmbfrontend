{
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/profile\\?tab=(profile|vehicles|repairs|bookings|subscriptions)",
      "dest": "/index.html",
      "status": 200
    },
    {
      "src": "/service/[^/]+",
      "dest": "/index.html",
      "status": 200
    },
    {
      "src": "/vehicles/[^/]+",
      "dest": "/index.html",
      "status": 200
    },
    {
      "src": "/verify-email/[^/]+",
      "dest": "/index.html",
      "status": 200
    },
    {
      "src": "/reset-password/[^/]+",
      "dest": "/index.html",
      "status": 200
    },
    {
      "src": "/(login|signup|about-us|how-it-works|subscription|vehicles|profile|cart|checkout|sell-vehicle|contact)",
      "dest": "/index.html",
      "status": 200
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "public": true,
  "trailingSlash": false,
  "github": {
    "silent": true
  }
}